<!DOCTYPE html>
<html lang="ur">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Talha AI Chat</title>
<style>
:root{--bg:#101116;--panel:#1b1c22;--text:#f2f3f7;--muted:#a5a7b3;--accent:#8ab4f8;--line:#30313a}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,"Noto Nastaliq Urdu",sans-serif;height:100dvh;display:flex;flex-direction:column}
header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line);background:#14151b}
.brand{font-size:20px;font-weight:700}.brand span{color:var(--accent)}button{cursor:pointer;border:0;border-radius:24px;padding:11px 15px;background:#2a2b34;color:var(--text);font-size:14px}button.primary{background:var(--accent);color:#101116;font-weight:bold}
#chat{flex:1;overflow-y:auto;padding:20px 14px 120px;max-width:850px;width:100%;margin:auto}
.welcome{text-align:center;margin:12vh auto 30px;max-width:600px}.welcome h1{font-size:clamp(27px,5vw,42px);margin-bottom:10px;background:linear-gradient(90deg,#8ab4f8,#c58af9,#8ab4f8);color:transparent;background-clip:text}.welcome p{color:var(--muted);line-height:1.7}
.msg{display:flex;margin:18px 0;gap:10px;align-items:flex-start}.avatar{flex:0 0 34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#2a2b34;color:var(--accent);font-weight:bold}.bubble{line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere;max-width:calc(100% - 44px);padding:12px 15px;border-radius:17px;background:var(--panel)}.user .bubble{background:#273449}.user{justify-content:flex-end}.user .avatar{order:2;background:#39547b;color:white}
.bottom{position:fixed;bottom:0;left:0;right:0;padding:12px 14px 18px;background:linear-gradient(transparent,var(--bg) 20%);}.composer{max-width:850px;margin:auto;background:var(--panel);border:1px solid #3a3b46;border-radius:25px;padding:10px;display:flex;gap:8px;align-items:flex-end;box-shadow:0 8px 30px #0005}.composer textarea{flex:1;resize:none;background:transparent;color:var(--text);border:0;outline:0;min-height:42px;max-height:140px;padding:12px;font:16px Arial,sans-serif}.tools{display:flex;gap:6px;align-items:center}.small{padding:10px 12px;border-radius:50%}#file{display:none}.hint{text-align:center;font-size:11px;color:var(--muted);margin-top:8px}
.overlay{position:fixed;inset:0;background:#0009;display:none;align-items:center;justify-content:center;padding:18px}.modal{width:100%;max-width:440px;background:var(--panel);padding:22px;border-radius:20px;border:1px solid var(--line)}.modal h2{margin-top:0}.modal input{width:100%;padding:13px;border-radius:12px;border:1px solid var(--line);background:#101116;color:white;margin:10px 0 14px}.modal p{color:var(--muted);font-size:13px;line-height:1.6}.row{display:flex;gap:8px;justify-content:flex-end}
#preview{max-width:180px;max-height:140px;border-radius:12px;display:none;margin:6px 0}
@media(min-width:700px){.bottom{padding-bottom:22px}}
</style></head>
<body>
<header><div class="brand"><span>✦</span> Talha AI</div><div style="display:flex;gap:8px"><button onclick="newChat()">＋ New chat</button><button onclick="openSettings()">⚙</button></div></header>
<main id="chat"><div class="welcome" id="welcome"><h1>ہیلو! آج میں آپ کی کیا مدد کروں؟</h1><p>کسی بھی موضوع پر سوال پوچھیں، آئیڈیا لکھیں یا تصویر کے بارے میں سوال کریں۔</p><div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap"><button onclick="suggest('مجھے اردو میں ایک خوبصورت نظم لکھ دیں')">✍️ نظم لکھیں</button><button onclick="suggest('مجھے ایک کاروباری آئیڈیا بتائیں')">💡 کاروباری آئیڈیا</button><button onclick="suggest('Explain artificial intelligence simply')">🤖 AI سمجھائیں</button></div></div></main>
<div class="bottom"><div class="composer"><button class="small" title="تصویر منتخب کریں" onclick="document.getElementById('file').click()">＋</button><input id="file" type="file" accept="image/*" onchange="pickImage(event)"><div style="flex:1"><img id="preview"><textarea id="prompt" rows="1" placeholder="یہاں پیغام لکھیں..." onkeydown="keySend(event)"></textarea></div><div class="tools"><button class="small" title="مائیکروفون" onclick="voice()">🎙</button><button class="primary small" onclick="send()">➤</button></div></div><div class="hint">AI کے جواب غلط بھی ہو سکتے ہیں، اہم معلومات کی تصدیق کریں۔</div></div>
<div class="overlay" id="settings"><div class="modal"><h2>⚙ Settings</h2><label for="api">Google Gemini API Key</label><input id="api" type="password" placeholder="API key یہاں پیسٹ کریں"><label for="model">Model</label><input id="model" value="gemini-2.5-flash"><p>API key اس براؤزر میں محفوظ ہوگی۔ یہ سادہ HTML ڈیمو ہے؛ عوامی ایپ میں API key کو محفوظ رکھنے کے لیے اپنے سرور/بیک اینڈ کا استعمال کریں۔ اپنی key کسی کے ساتھ شیئر نہ کریں۔</p><div class="row"><button onclick="closeSettings()">منسوخ</button><button class="primary" onclick="saveSettings()">محفوظ کریں</button></div></div></div>
<script>
let history=[],imageData=null;
const chat=document.getElementById('chat'), promptBox=document.getElementById('prompt');
function openSettings(){document.getElementById('api').value=sessionStorage.getItem('gemini_key')||localStorage.getItem('gemini_key')||'';document.getElementById('model').value=localStorage.getItem('gemini_model')||'gemini-2.5-flash';document.getElementById('settings').style.display='flex'}
function closeSettings(){document.getElementById('settings').style.display='none'}
function saveSettings(){const k=document.getElementById('api').value.trim();if(k)localStorage.setItem('gemini_key',k);else localStorage.removeItem('gemini_key');localStorage.setItem('gemini_model',document.getElementById('model').value.trim()||'gemini-2.5-flash');closeSettings();alert('Settings محفوظ ہوگئیں۔')}
function newChat(){history=[];chat.innerHTML='';imageData=null;document.getElementById('preview').style.display='none';document.getElementById('welcome').style.display='block';chat.appendChild(document.getElementById('welcome'))}
function suggest(t){promptBox.value=t;promptBox.focus()}
function addMsg(text,who){document.getElementById('welcome')?.remove();let wrap=document.createElement('div');wrap.className='msg '+who;let av=document.createElement('div');av.className='avatar';av.textContent=who==='user'?'آپ':'✦';let b=document.createElement('div');b.className='bubble';b.textContent=text;wrap.append(av,b);chat.appendChild(wrap);chat.scrollTop=chat.scrollHeight;return b}
function keySend(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send()}}
function pickImage(e){const f=e.target.files[0];if(!f)return;if(!f.type.startsWith('image/'))return alert('براہ کرم تصویر منتخب کریں');const r=new FileReader();r.onload=()=>{imageData=r.result.split(',')[1];const p=document.getElementById('preview');p.src=r.result;p.style.display='block'};r.readAsDataURL(f)}
async function send(){let text=promptBox.value.trim();if(!text&&!imageData)return;const key=localStorage.getItem('gemini_key');if(!key){openSettings();alert('پہلے Settings میں Gemini API key شامل کریں۔');return}
addMsg(text||'اس تصویر کو دیکھیں', 'user');promptBox.value='';const img=imageData;imageData=null;document.getElementById('preview').style.display='none';
const reply=addMsg('سوچ رہا ہوں…','assistant');let parts=[];if(text)parts.push({text});if(img)parts.push({inline_data:{mime_type:'image/jpeg',data:img}});
history.push({role:'user',parts});try{const model=localStorage.getItem('gemini_model')||'gemini-2.5-flash';const res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(key)}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contents:history,generationConfig:{temperature:0.7,maxOutputTokens:2048}})});const data=await res.json();if(!res.ok)throw new Error(data.error?.message||'API request ناکام ہوگئی');const answer=data.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('')||'جواب موصول نہیں ہوا۔';reply.textContent=answer;history.push({role:'model',parts:[{text:answer}]})}catch(e){reply.textContent='خرابی: '+e.message+'\nاپنی API key، انٹرنیٹ اور ماڈل کا نام چیک کریں۔';history.pop()}chat.scrollTop=chat.scrollHeight}
function voice(){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){alert('آپ کے براؤزر میں voice input دستیاب نہیں۔');return}const r=new SR();r.lang='ur-PK';r.onresult=e=>{promptBox.value+=(promptBox.value?' ':'')+e.results[0][0].transcript};r.start()}
</script></body></html>
